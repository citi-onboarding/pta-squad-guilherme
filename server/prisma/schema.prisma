// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model UserForExample {
  id_user   String  @id @default(uuid())
  name      String
  email     String
  CPF       String
  password  String
  phone     String? 
}

//Book status enumeration
enum Status {
  EM_ANDAMENTO 
  DEVOLVIDO    
  ATRASADO     
}

//Loan
//I used "pnpm prisma format" to make the code prettier
model Loan {
  id           String   @id @default(uuid())
  idBook       String
  Name         String
  Email        String
  dateBorrow   DateTime
  dateGiveBack DateTime
  statusBook   Status
}