{
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "es2017",
    "module": "commonjs",
    "lib": [
      "ES2017"
    ],
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "typeRoots": [
      "./node_modules/@types",
      "./src/@types"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "strict": true,
    "ignoreDeprecations": "5.0",
    "paths": {
      "@controllers": ["./src/controllers"],
      "@controllers/*": ["./src/controllers/*"],
      "@repositories": ["./src/repositories"],
      "@repositories/*": ["./src/repositories/*"],
      "@services": ["./src/services"],
      "@services/*": ["./src/services/*"],
      "@routes": ["./src/routes"],
      "@routes/*": ["./src/routes/*"],
      "@middlewares": ["./src/middlewares"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@dtos": ["./src/dtos"],
      "@dtos/*": ["./src/dtos/*"],
      "@errors": ["./src/errors"],
      "@errors/*": ["./src/errors/*"],
      "@utils": ["./src/utils"],
      "@utils/*": ["./src/utils/*"],
      "@database": ["./src/database"],
      "@database/*": ["./src/database/*"]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "tests"
  ]
}